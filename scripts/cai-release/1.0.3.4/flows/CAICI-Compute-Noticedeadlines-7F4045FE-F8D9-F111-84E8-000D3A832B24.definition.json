{
 "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
 "contentVersion": "1.0.0.0",
 "parameters": {
  "$connections": {
   "defaultValue": {},
   "type": "Object"
  },
  "$authentication": {
   "defaultValue": {},
   "type": "SecureObject"
  }
 },
 "triggers": {
  "manual": {
   "type": "Request",
   "kind": "Skills",
   "inputs": {
    "schema": {
     "type": "object",
     "properties": {
      "text": {
       "title": "rows_json",
       "type": "string",
       "x-ms-dynamically-added": true,
       "description": "JSON of the Dataverse List rows response read with the user's credentials",
       "x-ms-content-hint": "TEXT"
      },
      "number": {
       "title": "days_ahead",
       "type": "number",
       "x-ms-dynamically-added": true,
       "description": "Days ahead (default 90)",
       "x-ms-content-hint": "NUMBER"
      }
     },
     "required": [
      "text"
     ]
    }
   }
  }
 },
 "actions": {
  "Today": {
   "type": "Compose",
   "inputs": "@convertFromUtc(utcNow(), 'Central Europe Standard Time', 'yyyy-MM-dd')",
   "runAfter": {}
  },
  "Init_Result": {
   "type": "InitializeVariable",
   "inputs": {
    "variables": [
     {
      "name": "Result",
      "type": "string",
      "value": ""
     }
    ]
   },
   "runAfter": {
    "Today": [
     "Succeeded"
    ]
   }
  },
  "Init_Latest": {
   "type": "InitializeVariable",
   "inputs": {
    "variables": [
     {
      "name": "Latest",
      "type": "array",
      "value": []
     }
    ]
   },
   "runAfter": {
    "Init_Result": [
     "Succeeded"
    ]
   }
  },
  "Window_end": {
   "type": "Compose",
   "inputs": "@addDays(outputs('Today'), int(coalesce(triggerBody()?['number'], 90)), 'yyyy-MM-dd')",
   "runAfter": {
    "Init_Latest": [
     "Succeeded"
    ]
   }
  },
  "List_approved": {
   "type": "Compose",
   "inputs": "@json(triggerBody()?['text'])",
   "runAfter": {
    "Window_end": [
     "Succeeded"
    ]
   }
  },
  "Query_meta": {
   "type": "Compose",
   "inputs": {
    "source_table": "cai_contract",
    "returned_count": "@length(outputs('List_approved')?['value'])",
    "is_complete": "@empty(coalesce(outputs('List_approved')?['@odata.nextLink'], ''))",
    "total_matches": "@if(empty(coalesce(outputs('List_approved')?['@odata.nextLink'], '')), length(outputs('List_approved')?['value']), null)",
    "page_policy": "server pagination on, up to 100000 rows; is_complete=false means more rows exist and the result must not be treated as complete"
   },
   "runAfter": {
    "List_approved": [
     "Succeeded"
    ]
   }
  },
  "Approved_masters": {
   "type": "Query",
   "inputs": {
    "from": "@outputs('List_approved')?['value']",
    "where": "@equals(item()?['cai_documentrole'], 'master')"
   },
   "runAfter": {
    "Query_meta": [
     "Succeeded"
    ]
   }
  },
  "References": {
   "type": "Select",
   "inputs": {
    "from": "@body('Approved_masters')",
    "select": "@toLower(trim(first(split(coalesce(item()?['cai_contractreference'], ''), ' / '))))"
   },
   "runAfter": {
    "Approved_masters": [
     "Succeeded"
    ]
   }
  },
  "For_each_contract": {
   "type": "Foreach",
   "foreach": "@union(body('References'), body('References'))",
   "actions": {
    "Master_rows": {
     "type": "Query",
     "inputs": {
      "from": "@body('Approved_masters')",
      "where": "@equals(toLower(trim(first(split(coalesce(item()?['cai_contractreference'], ''), ' / ')))), items('For_each_contract'))"
     },
     "runAfter": {}
    },
    "Amendment_rows": {
     "type": "Query",
     "inputs": {
      "from": "@outputs('List_approved')?['value']",
      "where": "@and(not(equals(item()?['cai_documentrole'], 'master')), equals(toLower(trim(first(split(coalesce(item()?['cai_contractreference'], ''), ' / ')))), items('For_each_contract')))"
     },
     "runAfter": {
      "Master_rows": [
       "Succeeded"
      ]
     }
    },
    "Amendment_ids": {
     "type": "Select",
     "inputs": {
      "from": "@body('Amendment_rows')",
      "select": "@concat(item()?['cai_contractid'], '@', string(coalesce(item()?['cai_contentversion'], 0)))"
     },
     "runAfter": {
      "Amendment_rows": [
       "Succeeded"
      ]
     }
    },
    "Entry": {
     "type": "Compose",
     "inputs": {
      "contract_reference": "@first(body('Master_rows'))?['cai_contractreference']",
      "document": "@first(body('Master_rows'))?['cai_documentname']",
      "notice_deadline": "@if(or(startsWith(coalesce(first(body('Master_rows'))?['cai_noticestatus'], ''), 'DEADLINE NOT VERIFIED'), not(empty(coalesce(first(body('Master_rows'))?['cai_deadlinereview'], ''))), and(not(empty(coalesce(first(body('Master_rows'))?['cai_noticedeadline'], ''))), empty(coalesce(first(body('Master_rows'))?['cai_deadlinebasis'], '')))), null, first(body('Master_rows'))?['cai_noticedeadline'])",
      "stops_renewal_on": "@if(or(startsWith(coalesce(first(body('Master_rows'))?['cai_noticestatus'], ''), 'DEADLINE NOT VERIFIED'), not(empty(coalesce(first(body('Master_rows'))?['cai_deadlinereview'], ''))), and(not(empty(coalesce(first(body('Master_rows'))?['cai_noticedeadline'], ''))), empty(coalesce(first(body('Master_rows'))?['cai_deadlinebasis'], '')))), null, first(body('Master_rows'))?['cai_noticetermend'])",
      "previous_cycle_status": "@if(or(startsWith(coalesce(first(body('Master_rows'))?['cai_noticestatus'], ''), 'DEADLINE NOT VERIFIED'), not(empty(coalesce(first(body('Master_rows'))?['cai_deadlinereview'], ''))), and(not(empty(coalesce(first(body('Master_rows'))?['cai_noticedeadline'], ''))), empty(coalesce(first(body('Master_rows'))?['cai_deadlinebasis'], '')))), 'NOT_VERIFIED', coalesce(first(body('Master_rows'))?['cai_previouscyclestatus'], 'NOT_APPLICABLE'))",
      "previous_notice_deadline": "@if(or(startsWith(coalesce(first(body('Master_rows'))?['cai_noticestatus'], ''), 'DEADLINE NOT VERIFIED'), not(empty(coalesce(first(body('Master_rows'))?['cai_deadlinereview'], ''))), and(not(empty(coalesce(first(body('Master_rows'))?['cai_noticedeadline'], ''))), empty(coalesce(first(body('Master_rows'))?['cai_deadlinebasis'], '')))), null, first(body('Master_rows'))?['cai_previousnoticedeadline'])",
      "renewal_basis": "@first(body('Master_rows'))?['cai_renewalbasis']",
      "current_term_end": "@first(body('Master_rows'))?['cai_currenttermend']",
      "register_summary": "@if(or(startsWith(coalesce(first(body('Master_rows'))?['cai_noticestatus'], ''), 'DEADLINE NOT VERIFIED'), not(empty(coalesce(first(body('Master_rows'))?['cai_deadlinereview'], ''))), and(not(empty(coalesce(first(body('Master_rows'))?['cai_noticedeadline'], ''))), empty(coalesce(first(body('Master_rows'))?['cai_deadlinebasis'], '')))), if(startsWith(coalesce(first(body('Master_rows'))?['cai_noticestatus'], ''), 'DEADLINE NOT VERIFIED'), first(body('Master_rows'))?['cai_noticestatus'], 'DEADLINE NOT VERIFIED - HUMAN REVIEW REQUIRED. The stored deadline was calculated by an earlier release or needs a human check; it is withheld until the register recalculates it and a reviewer confirms it.'), first(body('Master_rows'))?['cai_noticestatus'])",
      "terms_computed_on": "@first(body('Master_rows'))?['cai_termscomputedon']",
      "stale": "@or(empty(coalesce(first(body('Master_rows'))?['cai_termscomputedon'], '')), not(equals(coalesce(first(body('Master_rows'))?['cai_termsbasis'], ''), concat(first(body('Master_rows'))?['cai_contractid'], '@', string(coalesce(first(body('Master_rows'))?['cai_contentversion'], 0)), '|', join(sort(body('Amendment_ids')), ',')))))",
      "execution_status": "@coalesce(first(body('Master_rows'))?['cai_executionstatus'], 'UNKNOWN')",
      "execution_warning": "@first(body('Master_rows'))?['cai_executionwarning']",
      "notice_period_amount": "@first(body('Master_rows'))?['cai_noticeamount']",
      "notice_period_unit": "@first(body('Master_rows'))?['cai_noticeunit']",
      "notice_wording": "@first(body('Master_rows'))?['cai_noticewording']",
      "deadline_basis": "@if(or(startsWith(coalesce(first(body('Master_rows'))?['cai_noticestatus'], ''), 'DEADLINE NOT VERIFIED'), not(empty(coalesce(first(body('Master_rows'))?['cai_deadlinereview'], ''))), and(not(empty(coalesce(first(body('Master_rows'))?['cai_noticedeadline'], ''))), empty(coalesce(first(body('Master_rows'))?['cai_deadlinebasis'], '')))), null, first(body('Master_rows'))?['cai_deadlinebasis'])",
      "deadline_review": "@first(body('Master_rows'))?['cai_deadlinereview']",
      "deadline_verification": "@if(or(startsWith(coalesce(first(body('Master_rows'))?['cai_noticestatus'], ''), 'DEADLINE NOT VERIFIED'), not(empty(coalesce(first(body('Master_rows'))?['cai_deadlinereview'], ''))), and(not(empty(coalesce(first(body('Master_rows'))?['cai_noticedeadline'], ''))), empty(coalesce(first(body('Master_rows'))?['cai_deadlinebasis'], '')))), 'NOT VERIFIED', if(empty(coalesce(first(body('Master_rows'))?['cai_noticedeadline'], '')), 'NO DEADLINE', 'CONFIRMED'))"
     },
     "runAfter": {
      "Amendment_ids": [
       "Succeeded"
      ]
     }
    },
    "Keep_latest": {
     "type": "AppendToArrayVariable",
     "inputs": {
      "name": "Latest",
      "value": "@outputs('Entry')"
     },
     "runAfter": {
      "Entry": [
       "Succeeded"
      ]
     }
    }
   },
   "runAfter": {
    "References": [
     "Succeeded"
    ]
   },
   "runtimeConfiguration": {
    "concurrency": {
     "repetitions": 1
    }
   }
  },
  "Fresh": {
   "type": "Query",
   "inputs": {
    "from": "@variables('Latest')",
    "where": "@equals(item()?['stale'], false)"
   },
   "runAfter": {
    "For_each_contract": [
     "Succeeded"
    ]
   }
  },
  "Stale": {
   "type": "Query",
   "inputs": {
    "from": "@variables('Latest')",
    "where": "@equals(item()?['stale'], true)"
   },
   "runAfter": {
    "Fresh": [
     "Succeeded"
    ]
   }
  },
  "In_window": {
   "type": "Query",
   "inputs": {
    "from": "@body('Fresh')",
    "where": "@and(not(empty(coalesce(item()?['notice_deadline'], ''))), greaterOrEquals(ticks(item()?['notice_deadline']), ticks(outputs('Today'))), lessOrEquals(ticks(item()?['notice_deadline']), ticks(outputs('Window_end'))))"
   },
   "runAfter": {
    "Stale": [
     "Succeeded"
    ]
   }
  },
  "Passed_since_computation": {
   "type": "Query",
   "inputs": {
    "from": "@body('Fresh')",
    "where": "@and(not(empty(coalesce(item()?['notice_deadline'], ''))), less(ticks(item()?['notice_deadline']), ticks(outputs('Today'))))"
   },
   "runAfter": {
    "In_window": [
     "Succeeded"
    ]
   }
  },
  "No_deadline": {
   "type": "Query",
   "inputs": {
    "from": "@body('Fresh')",
    "where": "@and(empty(coalesce(item()?['notice_deadline'], '')), not(equals(item()?['deadline_verification'], 'NOT VERIFIED')))"
   },
   "runAfter": {
    "Passed_since_computation": [
     "Succeeded"
    ]
   }
  },
  "In_window_list": {
   "type": "Select",
   "inputs": {
    "from": "@sort(body('In_window'), 'notice_deadline')",
    "select": {
     "contract_reference": "@item()?['contract_reference']",
     "document": "@item()?['document']",
     "next_notice_status": "UPCOMING",
     "notice_deadline": "@item()?['notice_deadline']",
     "days_left": "@div(sub(ticks(item()?['notice_deadline']), ticks(outputs('Today'))), 864000000000)",
     "stops_renewal_on": "@item()?['stops_renewal_on']",
     "previous_cycle_status": "@item()?['previous_cycle_status']",
     "previous_notice_deadline": "@item()?['previous_notice_deadline']",
     "renewal_basis": "@item()?['renewal_basis']",
     "terms_computed_on": "@item()?['terms_computed_on']",
     "execution_status": "@item()?['execution_status']",
     "execution_warning": "@item()?['execution_warning']",
     "deadline_status": "CONFIRMED",
     "notice_period_amount": "@item()?['notice_period_amount']",
     "notice_period_unit": "@item()?['notice_period_unit']",
     "notice_wording": "@item()?['notice_wording']",
     "deadline_basis": "@item()?['deadline_basis']"
    }
   },
   "runAfter": {
    "Not_verified": [
     "Succeeded"
    ]
   }
  },
  "No_deadline_list": {
   "type": "Select",
   "inputs": {
    "from": "@body('No_deadline')",
    "select": {
     "contract_reference": "@item()?['contract_reference']",
     "document": "@item()?['document']",
     "renewal_basis": "@item()?['renewal_basis']",
     "reason": "@coalesce(item()?['register_summary'], 'no deadline stored')",
     "execution_status": "@item()?['execution_status']",
     "execution_warning": "@item()?['execution_warning']"
    }
   },
   "runAfter": {
    "In_window_list": [
     "Succeeded"
    ]
   }
  },
  "Result": {
   "type": "Compose",
   "inputs": {
    "status": "@if(outputs('Query_meta')?['is_complete'], 'OK', 'INCOMPLETE_RESULT')",
    "rule": "Approved master agreements only (a document with an unresolved correction never counts), one per contract (latest approved upload). Status and days left are computed now from stored deadlines in the business timezone. Contracts whose stored terms do not match the current approved documents are listed as stale and excluded from the window. Only CONFIRMED deadlines are listed with a date: a calendar calculation from a reviewer-approved notice period, shown with the contract wording and the calculation basis. A deadline that a reviewer has not confirmed is listed under deadlines_not_verified with no date: say \"Deadline not verified — human review required\" and give no date. This is not legal advice.",
    "as_of": "@outputs('Today')",
    "business_timezone": "Europe/Prague",
    "window_days": "@int(coalesce(triggerBody()?['number'], 90))",
    "window_end": "@outputs('Window_end')",
    "query": "@outputs('Query_meta')",
    "approved_contracts_checked": "@length(variables('Latest'))",
    "count_in_window": "@length(body('In_window_list'))",
    "deadlines_in_window": "@body('In_window_list')",
    "deadlines_passed_since_computation_recompute_required": "@body('Passed_since_computation')",
    "effective_terms_stale": "@body('Stale')",
    "approved_contracts_without_deadline": "@body('No_deadline_list')",
    "count_not_verified": "@length(body('Not_verified_list'))",
    "deadlines_not_verified": "@body('Not_verified_list')"
   },
   "runAfter": {
    "Not_verified_list": [
     "Succeeded"
    ]
   }
  },
  "Set_Result": {
   "type": "SetVariable",
   "inputs": {
    "name": "Result",
    "value": "@{string(outputs('Result'))}"
   },
   "runAfter": {
    "Result": [
     "Succeeded"
    ]
   }
  },
  "Respond_to_the_agent": {
   "type": "Response",
   "kind": "Skills",
   "runAfter": {
    "Set_Result": [
     "Succeeded"
    ]
   },
   "inputs": {
    "statusCode": 200,
    "body": {
     "result": "@variables('Result')"
    },
    "schema": {
     "type": "object",
     "properties": {
      "result": {
       "title": "result",
       "x-ms-dynamically-added": true,
       "type": "string"
      }
     }
    }
   }
  },
  "Not_verified": {
   "type": "Query",
   "inputs": {
    "from": "@body('Fresh')",
    "where": "@equals(item()?['deadline_verification'], 'NOT VERIFIED')"
   },
   "runAfter": {
    "No_deadline": [
     "Succeeded"
    ]
   }
  },
  "Not_verified_list": {
   "type": "Select",
   "inputs": {
    "from": "@body('Not_verified')",
    "select": {
     "contract_reference": "@item()?['contract_reference']",
     "document": "@item()?['document']",
     "deadline_status": "Deadline not verified — human review required",
     "notice_deadline": null,
     "reason": "@coalesce(item()?['deadline_review'], item()?['register_summary'])",
     "current_term_end": "@item()?['current_term_end']",
     "notice_wording": "@item()?['notice_wording']",
     "execution_status": "@item()?['execution_status']",
     "execution_warning": "@item()?['execution_warning']"
    }
   },
   "runAfter": {
    "No_deadline_list": [
     "Succeeded"
    ]
   }
  }
 },
 "outputs": {}
}
