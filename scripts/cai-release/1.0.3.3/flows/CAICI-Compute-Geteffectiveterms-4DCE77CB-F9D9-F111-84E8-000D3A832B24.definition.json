{
 "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
 "contentVersion": "1.0.0.0",
 "parameters": {
  "$connections": {
   "defaultValue": {},
   "type": "Object"
  },
  "$authentication": {
   "defaultValue": {},
   "type": "SecureObject"
  }
 },
 "triggers": {
  "manual": {
   "type": "Request",
   "kind": "Skills",
   "inputs": {
    "schema": {
     "type": "object",
     "properties": {
      "text": {
       "title": "contract_reference",
       "type": "string",
       "x-ms-dynamically-added": true,
       "description": "Contract reference (an amendment reference is mapped to its master)",
       "x-ms-content-hint": "TEXT"
      },
      "rows": {
       "title": "rows_json",
       "type": "string",
       "x-ms-dynamically-added": true,
       "description": "JSON of the Dataverse List rows response read with the user's credentials",
       "x-ms-content-hint": "TEXT"
      }
     },
     "required": [
      "text",
      "rows"
     ]
    }
   }
  }
 },
 "actions": {
  "Reference": {
   "type": "Compose",
   "inputs": "@trim(first(split(trim(coalesce(triggerBody()?['text'], '')), ' / ')))",
   "runAfter": {}
  },
  "Today": {
   "type": "Compose",
   "inputs": "@convertFromUtc(utcNow(), 'Central Europe Standard Time', 'yyyy-MM-dd')",
   "runAfter": {
    "Reference": [
     "Succeeded"
    ]
   }
  },
  "Init_Result": {
   "type": "InitializeVariable",
   "inputs": {
    "variables": [
     {
      "name": "Result",
      "type": "string",
      "value": ""
     }
    ]
   },
   "runAfter": {
    "Today": [
     "Succeeded"
    ]
   }
  },
  "List_family": {
   "type": "Compose",
   "inputs": "@json(triggerBody()?['rows'])",
   "runAfter": {
    "Init_Result": [
     "Succeeded"
    ]
   }
  },
  "Query_meta": {
   "type": "Compose",
   "inputs": {
    "source_table": "cai_contract",
    "returned_count": "@length(outputs('List_family')?['value'])",
    "is_complete": "@empty(coalesce(outputs('List_family')?['@odata.nextLink'], ''))",
    "total_matches": "@if(empty(coalesce(outputs('List_family')?['@odata.nextLink'], '')), length(outputs('List_family')?['value']), null)",
    "page_policy": "server pagination on, up to 100000 rows; is_complete=false means more rows exist and the result must not be treated as complete"
   },
   "runAfter": {
    "List_family": [
     "Succeeded"
    ]
   }
  },
  "Family_rows": {
   "type": "Query",
   "inputs": {
    "from": "@outputs('List_family')?['value']",
    "where": "@equals(toLower(trim(first(split(coalesce(item()?['cai_contractreference'], ''), ' / ')))), toLower(outputs('Reference')))"
   },
   "runAfter": {
    "Query_meta": [
     "Succeeded"
    ]
   }
  },
  "Family_summary": {
   "type": "Select",
   "inputs": {
    "from": "@body('Family_rows')",
    "select": {
     "document": "@item()?['cai_documentname']",
     "reference": "@item()?['cai_contractreference']",
     "role": "@item()?['cai_documentrole']",
     "review_status": "@if(and(equals(item()?['cai_reviewstatus'], 'Approved'), equals(item()?['cai_approvalblocked'], true)), 'APPROVAL_BLOCKED_CORRECTION_UNRESOLVED', item()?['cai_reviewstatus'])",
     "correction_status": "@item()?['cai_correctionstatus']",
     "uploaded_on": "@item()?['createdon']",
     "execution_status": "@toUpper(coalesce(json(coalesce(item()?['cai_extractionjson'], '{}'))?['signature_status']?['value'], 'unknown'))",
     "content_version": "@coalesce(item()?['cai_contentversion'], 0)"
    }
   },
   "runAfter": {
    "Family_rows": [
     "Succeeded"
    ]
   }
  },
  "Approved_masters": {
   "type": "Query",
   "inputs": {
    "from": "@body('Family_rows')",
    "where": "@and(equals(item()?['cai_documentrole'], 'master'), and(equals(item()?['cai_reviewstatus'], 'Approved'), not(equals(item()?['cai_approvalblocked'], true))))"
   },
   "runAfter": {
    "Family_summary": [
     "Succeeded"
    ]
   }
  },
  "Approved_amendments": {
   "type": "Query",
   "inputs": {
    "from": "@body('Family_rows')",
    "where": "@and(not(equals(item()?['cai_documentrole'], 'master')), and(equals(item()?['cai_reviewstatus'], 'Approved'), not(equals(item()?['cai_approvalblocked'], true))))"
   },
   "runAfter": {
    "Approved_masters": [
     "Succeeded"
    ]
   }
  },
  "Excluded_documents": {
   "type": "Query",
   "inputs": {
    "from": "@body('Family_summary')",
    "where": "@not(equals(item()?['review_status'], 'Approved'))"
   },
   "runAfter": {
    "Approved_amendments": [
     "Succeeded"
    ]
   }
  },
  "Amendment_names": {
   "type": "Select",
   "inputs": {
    "from": "@body('Approved_amendments')",
    "select": "@concat(trim(coalesce(item()?['cai_contractreference'], '')), '=>', coalesce(item()?['cai_documentname'], ''))"
   },
   "runAfter": {
    "Excluded_documents": [
     "Succeeded"
    ]
   }
  },
  "Amendment_ids": {
   "type": "Select",
   "inputs": {
    "from": "@body('Approved_amendments')",
    "select": "@concat(item()?['cai_contractid'], '@', string(coalesce(item()?['cai_contentversion'], 0)))"
   },
   "runAfter": {
    "Amendment_names": [
     "Succeeded"
    ]
   }
  },
  "Approved_master_exists": {
   "type": "If",
   "expression": {
    "greater": [
     "@length(body('Approved_masters'))",
     0
    ]
   },
   "actions": {
    "Master": {
     "type": "Compose",
     "inputs": "@last(sort(body('Approved_masters'), 'createdon'))",
     "runAfter": {}
    },
    "Current_basis": {
     "type": "Compose",
     "inputs": "@concat(outputs('Master')?['cai_contractid'], '@', string(coalesce(outputs('Master')?['cai_contentversion'], 0)), '|', join(sort(body('Amendment_ids')), ','))",
     "runAfter": {
      "Master": [
       "Succeeded"
      ]
     }
    },
    "Is_fresh": {
     "type": "If",
     "expression": {
      "and": [
       {
        "equals": [
         "@coalesce(outputs('Master')?['cai_termsbasis'], '')",
         "@outputs('Current_basis')"
        ]
       },
       {
        "not": {
         "equals": [
          "@coalesce(outputs('Master')?['cai_termscomputedon'], '')",
          ""
         ]
        }
       }
      ]
     },
     "actions": {
      "Eff": {
       "type": "Compose",
       "inputs": "@json(coalesce(outputs('Master')?['cai_effectivetermsjson'], '{}'))",
       "runAfter": {}
      },
      "Master_extraction": {
       "type": "Compose",
       "inputs": "@json(coalesce(outputs('Master')?['cai_extractionjson'], '{}'))",
       "runAfter": {
        "Eff": [
         "Succeeded"
        ]
       }
      },
      "Fields": {
       "type": "Select",
       "inputs": {
        "from": "@createArray('contract_reference', 'contract_type', 'parties', 'signature_status', 'effective_date', 'initial_term', 'renewal', 'termination_for_convenience', 'termination_for_cause', 'change_of_control', 'fees', 'payment_terms', 'late_payment_interest', 'price_indexation', 'liability_cap', 'liability_exclusions', 'indemnities', 'ip_ownership', 'confidentiality_survival', 'data_protection', 'governing_law', 'jurisdiction', 'assignment', 'precedence_rule')",
        "select": {
         "field": "@item()",
         "value": "@outputs('Eff')?[item()]?['value']",
         "extraction_status": "@outputs('Eff')?[item()]?['status']",
         "source_reference": "@outputs('Eff')?[item()]?['source_document']",
         "source_document": "@if(equals(outputs('Eff')?[item()]?['source_role'], 'master'), outputs('Master')?['cai_documentname'], if(contains(concat('||', join(body('Amendment_names'), '||'), '||'), concat('||', coalesce(outputs('Eff')?[item()]?['source_document'], ''), '=>')), first(split(last(split(concat('||', join(body('Amendment_names'), '||'), '||'), concat('||', coalesce(outputs('Eff')?[item()]?['source_document'], ''), '=>'))), '||')), coalesce(outputs('Eff')?[item()]?['source_document'], '')))",
         "source_role": "@outputs('Eff')?[item()]?['source_role']",
         "location": "@outputs('Eff')?[item()]?['location']",
         "quote": "@outputs('Eff')?[item()]?['quote']",
         "master_value_before_amendment": "@if(equals(outputs('Eff')?[item()]?['source_role'], 'amendment'), outputs('Master_extraction')?[item()]?['value'], null)",
         "master_location": "@if(equals(outputs('Eff')?[item()]?['source_role'], 'amendment'), outputs('Master_extraction')?[item()]?['location'], null)",
         "master_quote": "@if(equals(outputs('Eff')?[item()]?['source_role'], 'amendment'), outputs('Master_extraction')?[item()]?['quote'], null)"
        }
       },
       "runAfter": {
        "Master_extraction": [
         "Succeeded"
        ]
       }
      },
      "Changed_by_amendment": {
       "type": "Query",
       "inputs": {
        "from": "@body('Fields')",
        "where": "@equals(item()?['source_role'], 'amendment')"
       },
       "runAfter": {
        "Fields": [
         "Succeeded"
        ]
       }
      },
      "Result_OK": {
       "type": "Compose",
       "inputs": {
        "contract_reference": "@outputs('Reference')",
        "as_of": "@outputs('Today')",
        "business_timezone": "Europe/Prague",
        "query": "@outputs('Query_meta')",
        "documents_in_family": "@body('Family_summary')",
        "status": "OK",
        "rule": "Only Approved documents count; a document with an unresolved correction (approval blocked) never counts, whatever its review status. Effective terms = latest approved master merged with approved amendments (latest amendment wins), computed and stored by the register (not by AI). Deadline status and days left are computed now, at query time, in the business timezone. Notice deadlines are calendar calculations from the notice period as stated (amount and unit), shown with the contract wording and the calculation basis; a PROVISIONAL deadline must be checked by a person. This is not legal advice.",
        "master_document": "@outputs('Master')?['cai_documentname']",
        "terms_computed_on": "@outputs('Master')?['cai_termscomputedon']",
        "terms_basis": "@outputs('Master')?['cai_termsbasis']",
        "renewal": {
         "renewal_basis": "@outputs('Master')?['cai_renewalbasis']",
         "renewal_period_months": "@outputs('Master')?['cai_renewalperiodmonths']",
         "effective_notice_days": "@outputs('Master')?['cai_effnoticedays']",
         "current_term_end": "@outputs('Master')?['cai_currenttermend']",
         "previous_cycle": {
          "status": "@coalesce(outputs('Master')?['cai_previouscyclestatus'], 'NOT_APPLICABLE')",
          "notice_deadline": "@outputs('Master')?['cai_previousnoticedeadline']",
          "applies_to_term_ending": "@if(equals(outputs('Master')?['cai_previouscyclestatus'], 'MISSED'), outputs('Master')?['cai_currenttermend'], null)"
         },
         "next_notice": {
          "status": "@if(empty(coalesce(outputs('Master')?['cai_noticedeadline'], '')), 'NONE', if(greaterOrEquals(ticks(outputs('Master')?['cai_noticedeadline']), ticks(outputs('Today'))), 'UPCOMING', 'PASSED_SINCE_COMPUTATION_RECOMPUTE_REQUIRED'))",
          "notice_deadline": "@outputs('Master')?['cai_noticedeadline']",
          "days_left": "@if(empty(coalesce(outputs('Master')?['cai_noticedeadline'], '')), null, div(sub(ticks(outputs('Master')?['cai_noticedeadline']), ticks(outputs('Today'))), 864000000000))",
          "stops_renewal_on": "@outputs('Master')?['cai_noticetermend']"
         },
         "register_summary": "@outputs('Master')?['cai_noticestatus']",
         "notice_period_amount": "@outputs('Master')?['cai_noticeamount']",
         "notice_period_unit": "@outputs('Master')?['cai_noticeunit']",
         "notice_wording": "@outputs('Master')?['cai_noticewording']",
         "deadline_basis": "@outputs('Master')?['cai_deadlinebasis']",
         "deadline_review": "@outputs('Master')?['cai_deadlinereview']",
         "deadline_status": "@if(empty(coalesce(outputs('Master')?['cai_deadlinereview'], '')), 'CALCULATED', 'PROVISIONAL - human check required')"
        },
        "execution": {
         "execution_status": "@coalesce(outputs('Master')?['cai_executionstatus'], 'UNKNOWN')",
         "warning": "@outputs('Master')?['cai_executionwarning']",
         "note": "Review status Approved means a reviewer accepted the extracted information. It does not mean the agreement is fully executed or legally effective; see execution_status and warning."
        },
        "effective_fees": "@outputs('Master')?['cai_efffees']",
        "effective_liability_cap": "@outputs('Master')?['cai_effliabilitycap']",
        "changed_by_amendment": "@body('Changed_by_amendment')",
        "effective_terms": "@body('Fields')",
        "not_counted_documents": "@body('Excluded_documents')",
        "approved_master_count": "@length(body('Approved_masters'))"
       },
       "runAfter": {
        "Changed_by_amendment": [
         "Succeeded"
        ]
       }
      },
      "Set_Result_OK": {
       "type": "SetVariable",
       "inputs": {
        "name": "Result",
        "value": "@{string(outputs('Result_OK'))}"
       },
       "runAfter": {
        "Result_OK": [
         "Succeeded"
        ]
       }
      }
     },
     "else": {
      "actions": {
       "Result_stale": {
        "type": "Compose",
        "inputs": {
         "contract_reference": "@outputs('Reference')",
         "as_of": "@outputs('Today')",
         "business_timezone": "Europe/Prague",
         "query": "@outputs('Query_meta')",
         "documents_in_family": "@body('Family_summary')",
         "status": "EFFECTIVE_TERMS_STALE",
         "message": "The stored effective terms were not computed from the current set of approved documents (or were never computed). They are withheld; the Effective terms flow must recompute before answering.",
         "master_document": "@outputs('Master')?['cai_documentname']",
         "terms_computed_on": "@outputs('Master')?['cai_termscomputedon']",
         "stored_terms_basis": "@outputs('Master')?['cai_termsbasis']",
         "current_approved_basis": "@outputs('Current_basis')"
        },
        "runAfter": {}
       },
       "Set_Result_stale": {
        "type": "SetVariable",
        "inputs": {
         "name": "Result",
         "value": "@{string(outputs('Result_stale'))}"
        },
        "runAfter": {
         "Result_stale": [
          "Succeeded"
         ]
        }
       }
      }
     },
     "runAfter": {
      "Current_basis": [
       "Succeeded"
      ]
     }
    }
   },
   "else": {
    "actions": {
     "Result_no_master": {
      "type": "Compose",
      "inputs": {
       "contract_reference": "@outputs('Reference')",
       "as_of": "@outputs('Today')",
       "business_timezone": "Europe/Prague",
       "query": "@outputs('Query_meta')",
       "documents_in_family": "@body('Family_summary')",
       "status": "NO_APPROVED_MASTER",
       "message": "No approved master agreement for this reference. Effective terms are not available; the documents listed are not valid until approved in the Teams review."
      },
      "runAfter": {}
     },
     "Set_Result_no_master": {
      "type": "SetVariable",
      "inputs": {
       "name": "Result",
       "value": "@{string(outputs('Result_no_master'))}"
      },
      "runAfter": {
       "Result_no_master": [
        "Succeeded"
       ]
      }
     }
    }
   },
   "runAfter": {
    "Amendment_ids": [
     "Succeeded"
    ]
   }
  },
  "Not_found": {
   "type": "If",
   "expression": {
    "equals": [
     "@length(body('Family_rows'))",
     0
    ]
   },
   "actions": {
    "Result_not_found": {
     "type": "Compose",
     "inputs": {
      "contract_reference": "@outputs('Reference')",
      "as_of": "@outputs('Today')",
      "business_timezone": "Europe/Prague",
      "query": "@outputs('Query_meta')",
      "documents_in_family": "@body('Family_summary')",
      "status": "NOT_FOUND",
      "message": "No document with this contract reference is visible to you in the register (it may not exist, or you may not have access to it)."
     },
     "runAfter": {}
    },
    "Set_Result_not_found": {
     "type": "SetVariable",
     "inputs": {
      "name": "Result",
      "value": "@{string(outputs('Result_not_found'))}"
     },
     "runAfter": {
      "Result_not_found": [
       "Succeeded"
      ]
     }
    }
   },
   "else": {
    "actions": {}
   },
   "runAfter": {
    "Approved_master_exists": [
     "Succeeded"
    ]
   }
  },
  "Completeness_guard": {
   "type": "If",
   "expression": {
    "equals": [
     "@outputs('Query_meta')?['is_complete']",
     false
    ]
   },
   "actions": {
    "Result_incomplete": {
     "type": "Compose",
     "inputs": {
      "contract_reference": "@outputs('Reference')",
      "as_of": "@outputs('Today')",
      "business_timezone": "Europe/Prague",
      "query": "@outputs('Query_meta')",
      "documents_in_family": "@body('Family_summary')",
      "status": "INCOMPLETE_RESULT",
      "message": "The register query returned only part of the matching rows; no answer is given because the approved family may be incomplete."
     },
     "runAfter": {}
    },
    "Set_Result_incomplete": {
     "type": "SetVariable",
     "inputs": {
      "name": "Result",
      "value": "@{string(outputs('Result_incomplete'))}"
     },
     "runAfter": {
      "Result_incomplete": [
       "Succeeded"
      ]
     }
    }
   },
   "else": {
    "actions": {}
   },
   "runAfter": {
    "Not_found": [
     "Succeeded"
    ]
   }
  },
  "Respond_to_the_agent": {
   "type": "Response",
   "kind": "Skills",
   "runAfter": {
    "Completeness_guard": [
     "Succeeded"
    ]
   },
   "inputs": {
    "statusCode": 200,
    "body": {
     "result": "@variables('Result')"
    },
    "schema": {
     "type": "object",
     "properties": {
      "result": {
       "title": "result",
       "x-ms-dynamically-added": true,
       "type": "string"
      }
     }
    }
   }
  }
 },
 "outputs": {}
}