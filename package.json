{
    "name":  "colleagueai-website",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build \u0026\u0026 node scripts/generate-agent-pages.mjs \u0026\u0026 node scripts/generate-llms-full.cjs \u0026\u0026 node scripts/generate-locale-pages.mjs \u0026\u0026 node scripts/localize-agent-ux.mjs \u0026\u0026 node scripts/generate-global-language-pages.cjs \u0026\u0026 node scripts/localize-global-page-copy.cjs \u0026\u0026 node scripts/i18n-translate-visible-copy.cjs \u0026\u0026 node scripts/localize-global-page-identity.cjs \u0026\u0026 node scripts/localize-marketing-content.cjs \u0026\u0026 node scripts/polish-trust-page-readability.cjs \u0026\u0026 node scripts/enforce-url-locale-controller.cjs \u0026\u0026 node scripts/final-i18n-page-polish.cjs \u0026\u0026 node scripts/inject-fixed-backtop.cjs \u0026\u0026 node scripts/finalize-home.cjs",
                    "lint":  "eslint .",
                    "preview":  "vite preview",
                    "test":  "vitest",
                    "test:run":  "vitest run",
                    "test:ui":  "vitest --ui",
                    "e2e":  "playwright test",
                    "e2e:headed":  "playwright test --headed",
                    "e2e:ui":  "playwright test --ui",
                    "e2e:report":  "playwright show-report",
                    "e2e:prod":  "playwright test --config=playwright.prod.config.js",
                    "visual":  "playwright test visual.spec.js --project=chromium",
                    "visual:update":  "playwright test visual.spec.js --project=chromium --update-snapshots",
                    "a11y":  "playwright test a11y.spec.js --project=chromium",
                    "lhci":  "npm run build \u0026\u0026 node ./scripts/run-lhci.mjs",
                    "lhci:report":  "start .lighthouseci",
                    "diacritics":  "playwright test diacritics.spec.js",
                    "edge-cases":  "playwright test edge-cases.spec.js --project=chromium",
                    "check":  "npm run lint \u0026\u0026 npm run test:run \u0026\u0026 npm run check:global-language \u0026\u0026 npm run check:localized-copy \u0026\u0026 npm run audit:i18n-visible \u0026\u0026 npm run check:url-locale",
                    "check:e2e":  "npm run lint \u0026\u0026 npm run test:run \u0026\u0026 playwright test",
                    "check:full":  "npm run lint \u0026\u0026 npm run test:run \u0026\u0026 playwright test \u0026\u0026 npm run lhci",
                    "smoke:prod":  "node scripts/smoke-production.mjs",
                    "check:global-language":  "node scripts/check-global-language-navigation.cjs",
                    "check:localized-copy":  "node scripts/check-localized-page-copy.cjs",
                    "audit:i18n-visible":  "node scripts/audit-visible-localized-copy.cjs",
                    "check:url-locale":  "node scripts/check-url-locale-controller.cjs",
                    "qa:static":  "node scripts/qa-static-site-audit.cjs",
                    "qa:report":  "playwright show-report",
                    "qa:all":  "npm run build \u0026\u0026 npm run qa:static \u0026\u0026 npm run qa:site",
                    "qa:site":  "npm run build \u0026\u0026 node scripts/run-playwright-static.cjs tests/e2e/full-site-qa.spec.ts",
                    "qa:site:headed":  "playwright test tests/e2e/full-site-qa.spec.ts --headed",
                    "qa:golive":  "playwright test tests/e2e/golive.spec.js",
                    "qa:backtop":  "npm run build \u0026\u0026 node scripts/run-playwright-static.cjs tests/e2e/back-to-top.spec.ts",
                    "qa:e2e":  "npm run ci:e2e",
                    "test:e2e":  "npm run ci:e2e",
                    "postbuild":  "node scripts/inject-fixed-backtop.cjs \u0026\u0026 node scripts/finalize-home.cjs \u0026\u0026 node scripts/apply-mobile-fix.cjs",
                    "ci:e2e":  "npm run build \u0026\u0026 node scripts/run-playwright-static.cjs tests/e2e/full-site-qa.spec.ts --project=chromium-desktop --workers=1 --reporter=line"
                },
    "dependencies":  {
                         "@anthropic-ai/sdk":  "^0.113.0",
                         "@sentry/react":  "^10.67.0",
                         "@vercel/analytics":  "^2.0.1",
                         "@vercel/speed-insights":  "^2.0.0",
                         "aws4fetch":  "^1.0.20",
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8",
                         "stripe":  "^22.3.2"
                     },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.12.1",
                            "@eslint/js":  "^10.0.1",
                            "@playwright/test":  "^1.62.0",
                            "@testing-library/jest-dom":  "^6.9.1",
                            "@testing-library/react":  "^16.3.2",
                            "@testing-library/user-event":  "^14.6.1",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^6.0.4",
                            "@vitest/ui":  "^4.1.10",
                            "eslint":  "^10.8.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.3",
                            "globals":  "^17.8.0",
                            "jsdom":  "^29.1.1",
                            "lighthouse":  "^13.4.1",
                            "serve":  "^14.2.6",
                            "vite":  "^8.1.5",
                            "vitest":  "^4.1.6"
                        },
    "overrides":  {
                      "tmp":  "^0.2.6",
                      "uuid":  "^11.1.1"
                  }
}
